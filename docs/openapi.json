{
  "openapi": "3.1.0",
  "info": {
    "title": "Авито.Кухня",
    "version": "1.0.0"
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health",
        "operationId": "health_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          }
        }
      }
    },
    "/menu": {
      "get": {
        "summary": "Menu",
        "operationId": "menu_menu_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Dish"
                  },
                  "type": "array",
                  "title": "Response Menu Menu Get"
                }
              }
            }
          }
        }
      }
    },
    "/orders": {
      "post": {
        "summary": "Create Order",
        "operationId": "create_order_orders_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OrderInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/orders/{order_id}": {
      "get": {
        "summary": "Get Order",
        "operationId": "get_order_orders__order_id__get",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/partner/orders": {
      "get": {
        "summary": "Partner Orders",
        "operationId": "partner_orders_partner_orders_get",
        "parameters": [
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(pending|accepted)$",
              "default": "pending",
              "title": "Status"
            }
          },
          {
            "name": "x-cafe-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Cafe-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Order"
                  },
                  "title": "Response Partner Orders Partner Orders Get"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/partner/orders/{order_id}/accept": {
      "post": {
        "summary": "Accept Order",
        "operationId": "accept_order_partner_orders__order_id__accept_post",
        "parameters": [
          {
            "name": "order_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Order Id"
            }
          },
          {
            "name": "x-cafe-token",
            "in": "header",
            "required": false,
            "schema": {
              "type": "string",
              "default": "",
              "title": "X-Cafe-Token"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Order"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Dish": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "restaurant_id": {
            "type": "integer",
            "title": "Restaurant Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price_kopecks": {
            "type": "integer",
            "title": "Price Kopecks"
          },
          "available": {
            "type": "boolean",
            "title": "Available"
          }
        },
        "type": "object",
        "required": [
          "id",
          "restaurant_id",
          "name",
          "price_kopecks",
          "available"
        ],
        "title": "Dish"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "ItemInput": {
        "properties": {
          "dish_id": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Dish Id"
          },
          "quantity": {
            "type": "integer",
            "maximum": 100.0,
            "exclusiveMinimum": 0.0,
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "dish_id",
          "quantity"
        ],
        "title": "ItemInput"
      },
      "Order": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "restaurant_id": {
            "type": "integer",
            "title": "Restaurant Id"
          },
          "customer_id": {
            "type": "string",
            "title": "Customer Id"
          },
          "address": {
            "type": "string",
            "title": "Address"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "total_kopecks": {
            "type": "integer",
            "title": "Total Kopecks"
          },
          "created_at": {
            "type": "string",
            "title": "Created At"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/OrderItem"
            },
            "type": "array",
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "id",
          "restaurant_id",
          "customer_id",
          "address",
          "status",
          "total_kopecks",
          "created_at",
          "items"
        ],
        "title": "Order"
      },
      "OrderInput": {
        "properties": {
          "customer_id": {
            "type": "string",
            "maxLength": 100,
            "minLength": 1,
            "title": "Customer Id"
          },
          "address": {
            "type": "string",
            "maxLength": 300,
            "minLength": 1,
            "title": "Address"
          },
          "items": {
            "items": {
              "$ref": "#/components/schemas/ItemInput"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Items"
          }
        },
        "type": "object",
        "required": [
          "customer_id",
          "address",
          "items"
        ],
        "title": "OrderInput"
      },
      "OrderItem": {
        "properties": {
          "dish_id": {
            "type": "integer",
            "title": "Dish Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "price_kopecks": {
            "type": "integer",
            "title": "Price Kopecks"
          },
          "quantity": {
            "type": "integer",
            "title": "Quantity"
          }
        },
        "type": "object",
        "required": [
          "dish_id",
          "name",
          "price_kopecks",
          "quantity"
        ],
        "title": "OrderItem"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}